# ============================================================
#  EduCenter — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git.
# ============================================================

# --- Server ---
PORT=8000
NODE_ENV=development          # change to "production" on the server

# --- JWT Authentication ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=1h

# --- Database ---
# Path is relative to the project root (used by services if you switch to env-based path)
DB_PATH=./data/database.sqlite

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
